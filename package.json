{
  "name": "@cy873889292/ai-codereview",
  "version": "1.0.5",
  "description": "龙虾驱动的 AI Code Review CLI 工具",
  "main": "dist/index.js",
  "bin": {
    "ai-codereview": "./dist/cli/index.js"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/cli/index.js",
    "prepublishOnly": "pnpm run build",
    "dev": "ts-node src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "lint": "eslint src/**/*.ts",
    "install-hooks": "bash scripts/install-hooks.sh"
  },
  "keywords": [
    "code-review",
    "ai",
    "mcp",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "acorn": "^8.11.3",
    "acorn-walk": "^8.3.2",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "eslint": "^8.56.0",
    "glob": "^*",
    "openai": "^4.20.0",
    "ora": "^5.4.1",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-node": "^*"
  }
}
